# ============================================================
# Suhana Education — environment variables
# Copy this file to `.env.local` and fill in real values.
# The app runs in DEMO MODE (local seed data, no real auth or
# payments) until the Supabase variables below are set.
# ============================================================

# ---- Supabase (required for real auth + database) ----
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is SERVER-ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site URL (used for OAuth redirects) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Razorpay (optional — payments stay in demo mode if unset) ----
# Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public key id exposed to the browser Checkout (same value as RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Dashboard → Webhooks → secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Phone OTP & Google OAuth ----
# These are configured inside Supabase, not here:
#   Auth → Providers → Phone  (connect an SMS provider: Twilio / MSG91 / etc.)
#   Auth → Providers → Google (add your Google OAuth client id + secret)
# No extra app env vars are needed once they are enabled in Supabase.
